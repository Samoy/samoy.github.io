---
import { siteConfig } from '../site.config';

interface Props {
  /** 备案信息展示规则：首页显示在侧栏首屏区，其他页面显示在页脚 */
  showIcp?: boolean;
}

const { showIcp = false } = Astro.props;
const current = Astro.url.pathname;

function isActive(url: string): boolean {
  if (url === '/') return current === '/';
  return current.startsWith(url);
}

const socialLinks = [
  { label: 'Samoy的微博', href: siteConfig.social.weibo, icon: 'weibo' },
  { label: 'Samoy的Github', href: siteConfig.social.github, icon: 'github' },
  { label: 'Samoy的twitter', href: siteConfig.social.twitter, icon: 'twitter' },
  { label: 'RSS 订阅', href: siteConfig.social.rss, icon: 'rss' },
  { label: '联系我', href: siteConfig.social.mail, icon: 'mail' },
];
---

<header class="sidebar" id="sidebar">
  <button class="theme-toggle" type="button" aria-label="切换明暗主题">
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="5"></circle>
      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
    </svg>
  </button>

  <div class="sidebar__brand-row">
    <div class="brand">
      <a href="/">
        <img class="brand__avatar" src="/assets/images/avatar.png" width="80" height="80" alt={`${siteConfig.title} logo`} />
      </a>
      <div>
        <h1 class="brand__title"><a href="/">{siteConfig.title}</a></h1>
        <p class="brand__desc">{siteConfig.description}</p>
      </div>
    </div>
    <button class="menu-btn" aria-label="打开菜单" aria-expanded="false" aria-controls="sidebar-drawer">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div class="sidebar__drawer" id="sidebar-drawer">
    <nav class="nav" aria-label="主导航">
      {siteConfig.nav.map((item) => (
        <a href={item.url} aria-current={isActive(item.url) ? 'page' : undefined}>{item.title}</a>
      ))}
    </nav>

    <nav class="social" aria-label="社交链接">
      {socialLinks.map((item) => (
        <a href={item.href} title={item.label} aria-label={item.label} target={item.href.startsWith('http') ? '_blank' : undefined} rel="me noopener">
          {item.icon === 'weibo' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.278 8.592c2.773-2.77 6.004-4.033 7.219-2.816c.537.537.588 1.464.244 2.572c-.178.557.524.25.524.25c2.241-.938 4.197-.994 4.91.027c.38.542.343 1.306-.008 2.19c-.163.407.048.47.36.563c1.262.392 2.668 1.336 2.668 3.004c0 2.763-3.98 6.239-9.964 6.239c-4.565 0-9.23-2.213-9.23-5.852c0-1.902 1.204-4.102 3.277-6.177m12.133 5.742c-.237-2.391-3.382-4.039-7.023-3.677c-3.64.359-6.403 2.59-6.167 4.98c.237 2.394 3.382 4.039 7.023 3.68c3.641-.362 6.401-2.592 6.167-4.983m-10.249.104c.754-1.528 2.712-2.39 4.446-1.94c1.792.463 2.707 2.154 1.976 3.799c-.744 1.683-2.883 2.58-4.695 1.994c-1.752-.566-2.493-2.295-1.727-3.853m2.715.578c-.563-.237-1.291.008-1.64.553c-.354.547-.189 1.201.371 1.456c.568.257 1.325.013 1.676-.55c.346-.568.163-1.217-.408-1.459m1.387-.578c-.216-.084-.486.018-.613.232c-.123.214-.054.458.163.547c.219.092.501-.012.628-.231c.123-.22.044-.466-.178-.548m5.694-11.514A5.83 5.83 0 0 1 21.5 4.72a5.84 5.84 0 0 1 1.22 5.704a.84.84 0 0 1-1.06.54a.844.844 0 0 1-.542-1.062a4.142 4.142 0 0 0-4.808-5.327a.845.845 0 0 1-.353-1.65m.626 2.926a2.836 2.836 0 0 1 3.29 3.648a.725.725 0 1 1-1.378-.45a1.38 1.38 0 0 0-.287-1.357a1.4 1.4 0 0 0-1.322-.426a.723.723 0 1 1-.303-1.415"/></svg>
          )}
          {item.icon === 'github' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.001 2c-5.525 0-10 4.475-10 10a9.99 9.99 0 0 0 6.837 9.488c.5.087.688-.213.688-.476c0-.237-.013-1.024-.013-1.862c-2.512.463-3.162-.612-3.362-1.175c-.113-.288-.6-1.175-1.025-1.413c-.35-.187-.85-.65-.013-.662c.788-.013 1.35.725 1.538 1.025c.9 1.512 2.337 1.087 2.912.825c.088-.65.35-1.087.638-1.337c-2.225-.25-4.55-1.113-4.55-4.938c0-1.088.387-1.987 1.025-2.687c-.1-.25-.45-1.275.1-2.65c0 0 .837-.263 2.75 1.024a9.3 9.3 0 0 1 2.5-.337c.85 0 1.7.112 2.5.337c1.913-1.3 2.75-1.024 2.75-1.024c.55 1.375.2 2.4.1 2.65c.637.7 1.025 1.587 1.025 2.687c0 3.838-2.337 4.688-4.562 4.938c.362.312.675.912.675 1.85c0 1.337-.013 2.412-.013 2.75c0 .262.188.574.688.474A10.02 10.02 0 0 0 22 12c0-5.525-4.475-10-10-10"/></svg>
          )}
          {item.icon === 'twitter' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m17.687 3.063l-4.996 5.711l-4.32-5.711H2.112l7.477 9.776l-7.086 8.099h3.034l5.469-6.25l4.78 6.25h6.102l-7.794-10.304l6.625-7.571zm-1.064 16.06L5.654 4.782h1.803l10.846 14.34z"/></svg>
          )}
          {item.icon === 'rss' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3c9.941 0 18 8.059 18 18h-3c0-8.284-6.716-15-15-15zm0 7c6.075 0 11 4.925 11 11h-3a8 8 0 0 0-8-8zm0 7a4 4 0 0 1 4 4H3z"/></svg>
          )}
          {item.icon === 'mail' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1m9.06 8.683L5.648 6.238L4.353 7.762l7.72 6.555l7.581-6.56l-1.308-1.513z"/></svg>
          )}
        </a>
      ))}
    </nav>

    <div class="sidebar__foot">
      {showIcp && (
        <div class="icp">
          <a href={siteConfig.icp.miit.url} target="_blank" rel="noopener">{siteConfig.icp.miit.label}</a>
          <br />
          <a href={siteConfig.icp.mps.url} target="_blank" rel="noopener">{siteConfig.icp.mps.label}</a>
        </div>
      )}
    </div>
  </div>
</header>

<script>
  const sidebar = document.getElementById('sidebar');
  const menuBtn = sidebar?.querySelector<HTMLButtonElement>('.menu-btn');
  menuBtn?.addEventListener('click', () => {
    const open = sidebar.classList.toggle('is-open');
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? '收起菜单' : '打开菜单');
  });

  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme === 'dark';
    if (dark) delete root.dataset.theme;
    else root.dataset.theme = 'dark';
    try {
      localStorage.setItem('theme', dark ? 'light' : 'dark');
    } catch {}
  });
</script>
