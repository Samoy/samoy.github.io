---
interface Props {
  page: {
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const { page } = Astro.props;
---

{page.lastPage > 1 && (
  <nav class="pagination" aria-label="分页导航">
    {page.url.prev ? (
      <a href={page.url.prev}>&larr; 最近</a>
    ) : (
      <span aria-hidden="true"></span>
    )}
    <span class="page-num">{page.currentPage} / {page.lastPage}</span>
    {page.url.next && <a href={page.url.next}>更早 &rarr;</a>}
  </nav>
)}
