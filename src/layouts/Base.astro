---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** 当前页面路径（含首尾斜杠） */
  path: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  /** 首页：备案显示在侧栏首屏区；其他页面显示在页脚 */
  isHome?: boolean;
  /** 内容区使用更宽的版心（时间线、分类页） */
  wide?: boolean;
}

const {
  title = siteConfig.title,
  description,
  path,
  type = 'website',
  publishedTime,
  isHome = false,
  wide = false,
} = Astro.props;

// 备案信息仅在与备案域名一致的构建中显示（www.samoy.site 部署在华为云）
const showIcp = siteConfig.url.includes('samoy.site');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} path={path} type={type} publishedTime={publishedTime} />
  </head>
  <body>
    <div class="shell">
      <Header showIcp={showIcp && isHome} />
      <main class="main">
        <div class:list={['content', { 'content--wide': wide }]}>
          <slot />
          <Footer showIcp={showIcp && !isHome} />
        </div>
      </main>
    </div>
  </body>
</html>
