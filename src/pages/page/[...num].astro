---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPosts, type Post } from '../../lib/posts';
import { siteConfig } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  const pageSize = siteConfig.postsPerPage;
  const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
  const paths = [];
  for (let p = 2; p <= lastPage; p++) {
    paths.push({
      params: { num: String(p) },
      props: {
        currentPage: p,
        lastPage,
        total: posts.length,
        data: posts.slice((p - 1) * pageSize, p * pageSize),
      },
    });
  }
  return paths;
}

interface Props {
  currentPage: number;
  lastPage: number;
  total: number;
  data: Post[];
}

const { currentPage, lastPage, total, data } = Astro.props;
const page = {
  currentPage,
  lastPage,
  url: {
    prev: currentPage === 2 ? '/' : `/page/${currentPage - 1}/`,
    next: currentPage < lastPage ? `/page/${currentPage + 1}/` : undefined,
  },
};
---

<Base
  path={`/page/${currentPage}/`}
  title={`第 ${currentPage} 页`}
  description={siteConfig.description}
>
  <div class="section-head">
    <h2>更早的文章</h2>
    <span class="count">共 {total} 篇 · 第 {currentPage} 页</span>
  </div>

  <ol class="post-list">
    {data.map((post, i) => <PostCard post={post} index={i} />)}
  </ol>

  <Pagination page={page} />
</Base>
